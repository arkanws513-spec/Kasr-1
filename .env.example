# Copy this file to .env locally or configure these as deployment secrets.
# Never commit a real API key.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.groq.com/openai/v1
# Current Groq model catalog is subject to change; override after checking provider availability.
INFERENCE_MODEL=openai/gpt-oss-120b
APP_NAME=Kasr-1
APP_ENV=production
# Comma-separated origins. Use * only for local testing without credentials.
CORS_ORIGINS=
MAX_INPUT_CHARS=20000
MAX_HISTORY_MESSAGES=30
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=60
