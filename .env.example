# Copy this file to .env locally or configure values as deployment secrets.
# Never commit a real API key or access token.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://router.huggingface.co/v1
INFERENCE_MODEL=openai/gpt-oss-120b:fastest
APP_NAME=Kasr-1
APP_ENV=production
# Generate a random secret with at least 32 characters. Keep it private.
KASR_ACCESS_TOKEN=replace_with_a_random_secret_at_least_32_characters
# Comma-separated origins. Use * only for local testing without credentials.
CORS_ORIGINS=
MAX_INPUT_CHARS=20000
MAX_HISTORY_MESSAGES=30
MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=60
